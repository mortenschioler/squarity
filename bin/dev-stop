#!/usr/bin/env bash
# Stop the dev server (shadow-cljs + Tailwind watch) and any running REPL session.

pgrep -f "shadow-cljs" | xargs -r kill 2>/dev/null || true
pgrep -f "tailwindcss.*watch" | xargs -r kill 2>/dev/null || true
pgrep -f "tail -f /dev/null > /tmp/squarity_repl" | xargs -r kill 2>/dev/null || true
rm -f /tmp/squarity_repl_out

echo "Dev server stopped."
