{:source-paths
 ["src/main" "src/test" "src/dev"]

 :dependencies
 [[reagent                  "1.0.0"]
  [re-frame/re-frame         "1.3.0"]

  ;; All dependencies live here regardless of environment. Test/dev deps don't
  ;; pollute the :app build because shadow-cljs only compiles namespaces reachable
  ;; from each build's entry point — test.check never enters the :app graph.
  [binaryage/devtools        "1.0.2"]
  [org.clojure/test.check    "1.1.1"]
  [cider/cider-nrepl         "0.28.7"]]

 :nrepl {:middleware [cider.nrepl/cider-middleware]}

 :dev-http
 {3000 "public"}

 :builds
 {:app
  {:target     :browser
   :output-dir "public/js"
   :asset-path "/js"
   :modules    {:main
                {:init-fn squarity.app.core/main}}
   :devtools   {:preloads      [squarity.dev]
               :repl-init-ns squarity.dev}}
  :test
  {:target    :node-test
   :output-to "out/test.js"}}

 :maven {:local-repo #shadow/env "SQUARITY_M2_LOCAL_REPO"}}
